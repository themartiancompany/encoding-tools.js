async function
  _assemble(
    _output_file,
    _input_files,
    _argument_type) {
  let
    _block,
    _block_current,
    _block_end,
    _data,
    _dir,
    _file,
    _file_current,
    _merge_list,
    _msg,
    _worker;
  if ( _argument_type == "list" ) {
    const
      _list =
        _input_files[
          0];
    _msg =
      `Merging files from list at ` +
      `'${_list}' into '${_output_file}'.`;
  }
  else if ( _argument_type == "file" ) {
    _msg =
      `Merging '${_input_files}' into ` +
      `'${_output_file}'.`;
  }
  _msg_info(
    _msg);
  const
    _fs_worker_started =
      await _fs_worker_start(
          "fs-worker.js");
  _file_current =
    1;
  _block_current =
    1;
  const
    _file_read_opts = {
      "encoding":
        "utf-8"
    };
  const
    _file_append_opts = {
      "encoding":
        null
    };
  _block =
    "";
  for ( _file of _input_files ) {
    _data =
      _file_read(
        _file,
        _file_read_opts);
    _block_end =
      false;
    if (_data.endsWith(
          '\n') ||
        _file_current == _input_files.length ) {
       _block_end =
         true;
    }
    _block =
      _block +
      _data;
    if ( _block_end ) {
      const
        _content =
          Buffer.from(
            _block,
            'base64');
      _block_current =
        _block_current + 1;
      _file_append(
        _output_file,
        _content,
        _file_append_opts);
      _block =
        "";
    }
    _file_current =
      _file_current + 1;
  }
  return true;
}

async function
  _base64_decode(
    _output_file,
    _input_files,
    _argument_type,
    _encoding_type) {
  let
    _data,
    _merge_list,
    _msg,
    _output_path_encoded_prefix,
    _txt;
  if ( typeof(
         _input_files) == "undefined" ||
       _input_files == [] ||
       _input_files == "" ) {
    _msg =
      "No input files given in input.";
    _msg_error(
      _msg,
      1);
  }

  _merge_list = [
    _input_files[
      0]
  ];
  if ( 0 < _input_files.length ) {
    const
      _tmp_dir =
        await _mktemp();
    _output_path_encoded_prefix =
      _path_join( [
        _tmp_dir,
        "merge.base64" ]);
    _merge_list =
      await _assemble(
        _output_file,
        _input_files,
        _argument_type);
  }
}

function
  _input_texts_check(
    _input_texts) {
  let
    _file,
    _input_file_exists;
  for ( _file of _input_texts ) {
    _input_file_exists =
      _file_exists(
        _file);
    if ( ! _input_file_exists ) {
      const
        _msg =
          `Input file '${_file}' does not ` +
          `exist.`;
        _msg_error(
          _msg,
          1);
    }
  }
}

function
  _output_file_check(
    _output_file) {
  const
    _output_file_exists =
      _file_exists(
        _output_file);
  if ( _output_file_exists ) {
    const
      _msg =
        `Input file '${_output_file}' does ` +
        `already exist, deleting.`;
    _msg_info(
      _msg);
    _rm(
      _output_file);
  }
}

function
  _argument_type_check(
    _argument_type) {
  let
    _argument_type_get,
    _msg;
  _argument_type_get =
    false;
  const
    _default =
      "file";
  const
    _argument_type_type =
      typeof(
        _argument_type);
  if ( _argument_type_type === "undefined" ) {
    _msg =
      "Argument type undefined, setting " +
      `default '${_default}'.`;
    _msg_info(
      _msg);
    _argument_type_get =
      true;
  }
  else if ( _argument_type_type === "string" ) {
    if ( _argument_type.length < 1 ) {
      _argument_type_get =
        true;
      _msg =
        "Argument type undefined, setting " +
        `default '${_default}'.`;
      _msg_info(
        _msg);
    }
    else {
      if ( _argument_type !== "file" &&
           _argument_type !== "list" ) {
        _msg =
          "Argument type variable should be a " +
          "string with values 'file' or 'list'.";
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
    }
  }
  else {
    _msg =
      "Argument type variable has type " +
      `'${_argument_type_type}', should have ` +
      "string with values 'file' or 'list'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _argument_type_get ) {
    _argument_type =
      _default;
  }
  return _argument_type;
}

function
  _input_files_sanity_check_check(
    _input_files_sanity_check) {
  let
    _input_files_sanity_check_get,
    _msg;
  _input_files_sanity_check_get =
    false;
  const
    _default =
      true;
  const
    _input_files_sanity_check_type =
       typeof(
        _input_files_sanity_check);
  if ( _input_files_sanity_check_type == "undefined" ) {
    _msg =
      "Variable 'input files sanity check' is " +
      `undefined, setting default '${_default}'.`;
    _msg_info(
      _msg);
    _input_files_sanity_check_get =
      true;
  }
  else if ( _input_files_sanity_check_type == "string" ) {
    if ( _input_files_sanity_check.length < 1 ) {
      _msg =
        "Variable 'input files sanity check' is " +
        `an empty string, setting default '${_default}'.`;
      _msg_info(
        _msg);
      _input_files_sanity_check_get =
        true;
    }
    else {
      if ( _input_files_sanity_check === "true" ||
           _input_files_sanity_check === "y" ) {
        _input_files_sanity_check =
          true;
      }
      else if ( _input_files_sanity_check === "false" ||
                _input_files_sanity_check === "n" ) {
        _input_files_sanity_check =
          false;
      }
      else {
        _msg =
          "Variable 'input files sanity check' " +
          `has value '${_input_files_sanity_check}'. ` +
          "Allowed values are 'true', 'false', 'y', 'n'.";
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
    }
  }
  else if ( _input_files_sanity_check_type == "boolean" ) {
    true;
  }
  else if ( _input_files_sanity_check_type == "object" ) {
    const
      _input_files_sanity_check_keys =
        Object.keys(
          _input_files_sanity_check);
    if ( _input_files_sanity_check_keys.length < 1 ) {
      _msg =
        "Variable 'input files sanity check' is " +
        `an empty object, setting default '${_default}'.`;
      _msg_info(
        _msg);
      _input_files_sanity_check_get =
        true;
    }
    else {
      _msg =
        "Variable 'input files sanity check' " +
        `is an non-empty object. ` +
        "Allowed values are 'true', 'false', 'y', 'n'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      "Variable 'input files sanity check' " +
      `has type '${_input_files_sanity_check_type}'. ` +
      "It should have type 'string' and its allowed " +
      "values are 'true', 'false', 'y', 'n'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _input_files_sanity_check_get ) {
    _input_files_sanity_check =
      _default;
  }
  return _input_files_sanity_check;
}

function
  _encoding_format_check(
    _encoding_format) {
  let
    _encoding_format_get,
    _msg;
  _encoding_format_get =
    false;
  const
    _default =
      "base64";
  const
    _encoding_format_type =
       typeof(
        _encoding_format);
  if ( _encoding_format_type == "undefined" ) {
    _msg =
      "Variable 'encoding format' is " +
      `undefined, setting default '${_default}'.`;
    _msg_info(
      _msg);
    _encoding_format_get =
      true;
  }
  else if ( _encoding_format_type == "string" ) {
    if ( _encoding_format.length < 1 ) {
      _msg =
        "Variable 'encoding format' is " +
        `an empty string, setting default '${_default}'.`;
      _msg_info(
        _msg);
      _encoding_format_get =
        true;
    }
    else {
      if ( _encoding_format !== "base64" ) {
        _msg =
          "Variable 'encoding format' " +
          `has value '${_encoding_format}'. ` +
          "Allowed values are 'base64'.";
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
    }
  }
  else if ( _encoding_format_type == "object" ) {
    const
      _encoding_format_keys =
        Object.keys(
          _encoding_format);
    if ( _encoding_format_keys.length < 1 ) {
      _msg =
        "Variable 'encoding format' is " +
        `an empty object, setting default '${_default}'.`;
      _msg_info(
        _msg);
      _encoding_format_get =
        true;
    }
    else {
      _msg =
        "Variable 'encoding format' " +
        `is an non-empty object. ` +
        "Allowed values are 'base64'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      "Variable 'encoding format' " +
      `has type '${_encoding_format_type}'. ` +
      "It should have type 'string' and its allowed " +
      "values are 'base64'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _encoding_format_get ) {
    _encoding_format =
      _default;
  }
  return _encoding_format;
}

async function
  _txt2bin(
    _output_file,
    _encoding_format,
    _argument_type,
    _encoding_type,
    _input_files,
    _input_files_sanity_check) {
  let
    _decoded,
    _msg;
  const
    _argument_type_check_args = [
      _argument_type
    ];
  try {
    _argument_type =
      _argument_type_check.apply(
        null,
        _argument_type_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_argument_type_check' with " +
      `argument '${_argument_type_check_args}'.`;
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  const
    _input_files_sanity_check_check_args = [
      _input_files_sanity_check
    ];
  try {
    _input_files_sanity_check =
      _input_files_sanity_check_check.apply(
        null,
        _input_files_sanity_check_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_input_files_sanity_check'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  const
    _encoding_format_check_args = [
      _encoding_format
    ];
  try {
    _encoding_format =
      _encoding_format_check.apply(
        null,
        _encoding_format_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_encoding_format_check'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  if ( _argument_type == "list" ) {
    const
      _list =
        _input_files[
          0];
    _input_files =
      _cat(
        _list).split(
          "\n");
  }
  if ( _input_files_sanity_check ) {
    _input_texts_check(
      _input_files);
  }
  const
    _output_file_check_args = [
      _output_file
    ];
  try {
    _output_file =
      _output_file_check.apply(
        null,
        _output_file_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_output_file_check'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  if ( _encoding_format == "base64" ) {
    _decoded =
      await _base64_decode(
        _output_file,
        _input_files,
        _argument_type,
        _encoding_type);
  }
  return _decoded;
}

